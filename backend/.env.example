# Copia este archivo como ".env" en la carpeta backend/ y llena los valores.
# Las variables marcadas (requerido) son necesarias para que el backend arranque.
# Las de MH / correo / pagos tienen un modo "simulacion" por defecto, asi que
# el sistema funciona sin credenciales reales hasta que decidas activarlas.

# --- Servidor ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# Origenes permitidos para CORS, separados por coma (sin espacios extra)
FRONTEND_URL=http://localhost:5173

# --- Autenticacion (requerido) -----------------------------------------
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Base de datos -------------------------------------------------------
# Ruta del archivo SQLite, relativa a backend/. Si tu hosting no tiene disco
# persistente (como el free tier de Render), la base se reinicia en cada
# redeploy — no uses esto para datos reales de produccion sin un disco
# persistente configurado.
DB_PATH=database/smartinvoice.db

# --- Datos fiscales del emisor (requerido antes de emitir documentos reales) ---
EMISOR_NIT=
EMISOR_NRC=
EMISOR_NOMBRE=
EMISOR_COD_ACTIVIDAD=
EMISOR_DESC_ACTIVIDAD=
EMISOR_NOMBRE_COMERCIAL=
EMISOR_TIPO_ESTABLECIMIENTO=02
EMISOR_DEPARTAMENTO=
EMISOR_MUNICIPIO=
EMISOR_COMPLEMENTO=
EMISOR_TELEFONO=
EMISOR_CORREO=

# --- Ministerio de Hacienda (transmision de DTEs) -----------------------
# 'simulacion' (por defecto): no llama a Hacienda, genera un sello falso.
# 'real': transmite de verdad. Requiere certificado + SVFE corriendo +
# credenciales de la API de Hacienda (ver README, seccion 3).
MH_MODO=simulacion
# '00' = ambiente de pruebas/certificacion del MH, '01' = produccion.
# Usa SIEMPRE '00' primero para validar que tus documentos son aceptados.
MH_AMBIENTE=00
# URLs de prueba confirmadas contra la guia de integracion oficial del MH.
# Para produccion, verifica la URL vigente en el portal del MH antes de
# cambiar (el patron documentado es apitest.dtes.mh.gob.sv -> api.dtes.mh.gob.sv,
# igual que ya indica el README de este proyecto).
MH_API_AUTH_URL=https://apitest.dtes.mh.gob.sv/seguridad/auth/
MH_API_RECEPCION_URL=https://apitest.dtes.mh.gob.sv/fesv/recepciondte
MH_USER=
MH_PASSWORD=

# --- Servicio de Firma Electronica (SVFE) del MH ------------------------
# El SVFE es un componente Java que Hacienda distribuye y que debes correr
# tu mismo (normalmente en la misma maquina que este backend). No es parte
# de este repositorio. Ver README seccion 3 para instrucciones.
FIRMADOR_URL=http://localhost:8113/firmardocumento/
FIRMADOR_TIMEOUT_MS=15000
# Password de la llave privada de tu certificado digital (la definiste al
# generar/instalar el certificado, no es tu password de Hacienda).
FIRMADOR_PASSWORD=

# --- Correo (notificaciones al portal del cliente) -----------------------
MAIL_MODO=simulacion
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Facturacion Electronica <no-reply@miempresa.com>
PORTAL_URL=http://localhost:5173/portal/login

# --- Pagos (Stripe, portal del cliente) -----------------------------------
PAGOS_MODO=simulacion
STRIPE_SECRET_KEY=
